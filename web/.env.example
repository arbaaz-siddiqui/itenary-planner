# Base URL of the Python backend that serves /auth/*, /chat/* per the API contract.
# No trailing slash. Leave blank to use same-origin relative paths.
NEXT_PUBLIC_API_URL=http://localhost:8000

# "true" serves canned sessions/messages and a fake SSE stream entirely in the
# browser — no backend needed. Set to "false" (or remove) to hit the real API.
NEXT_PUBLIC_MOCK_MODE=true
