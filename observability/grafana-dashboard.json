          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, outcome) (increase(agent_tool_calls_total{service_name=\"gujjutours-chat-api\"}[5m]))",
          "legendFormat": "{{tool}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
